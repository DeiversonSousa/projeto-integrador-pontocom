{
  "name": "portal-notificacoes-backend",
  "version": "1.0.0",
  "description": "API REST do Portal de Notificações por Região - SENAI FATESG",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "node dist/database/migrate.js && node dist/database/seed.js && node dist/server.js",
    "migrate": "tsx src/database/migrate.ts",
    "seed": "tsx src/database/seed.ts",
    "migrate:dist": "node dist/database/migrate.js",
    "seed:dist": "node dist/database/seed.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "senai",
    "projeto-integrador",
    "geolocalizacao",
    "notificacoes",
    "postgis"
  ],
  "author": "Equipe SENAI FATESG",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
